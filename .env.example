# Copy this file to .env and fill values only on your own computer.
# Never commit the real .env file.
# Choose one active provider: openai or gemini.
LLM_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Local Docker PostgreSQL. Replace the password only in your real .env file.
POSTGRES_DB=ai_support_agent
POSTGRES_USER=ai_support_agent
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_JWT_ISSUER=ai-support-agent
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
# false only for local HTTP development; true is required behind HTTPS in production.
AUTH_COOKIE_SECURE=false
