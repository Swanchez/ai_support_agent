{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON_ABSOLUTE_PATH__\" -B \"__HOOK_SCRIPT_ABSOLUTE_PATH__\"",
            "commandWindows": "& '__PYTHON_ABSOLUTE_PATH__' -B '__HOOK_SCRIPT_ABSOLUTE_PATH__'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
