{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON_ABSOLUTE_PATH__\" -B \"__PROTECT_FILES_SCRIPT_ABSOLUTE_PATH__\"",
            "commandWindows": "& '__PYTHON_ABSOLUTE_PATH__' -B '__PROTECT_FILES_SCRIPT_ABSOLUTE_PATH__'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
